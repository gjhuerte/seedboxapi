# Compose settings for docker-prod (copy to docker-prod/.env).
# Application settings (APP_KEY, DB_*, MAIL_* …) live in the project .env.

# Image name/tag. .github/workflows/docker.yml publishes to GHCR on every push
# to main and every v* tag, so point SEEDBOXAPI_IMAGE there to deploy CI builds:
#   SEEDBOXAPI_IMAGE=ghcr.io/gjhuerte/seedboxapi
# Pin SEEDBOXAPI_TAG to a version (v1.2.3 -> 1.2.3) or a commit SHA for a fixed
# deploy; `latest` always tracks main. Leave the default to build locally.
SEEDBOXAPI_IMAGE=seedboxapi
SEEDBOXAPI_TAG=latest

# Where the web server is published on the host. Keep 127.0.0.1 when a
# reverse proxy on the `proxy` network fronts the app.
SEEDBOXAPI_BIND=127.0.0.1
SEEDBOXAPI_HTTP_PORT=8010

# Existing Docker network shared with MariaDB and the reverse proxy.
SEEDBOXAPI_PROXY_NETWORK=proxy

# Resource limits for the container.
SEEDBOXAPI_CPUS=2.0
SEEDBOXAPI_MEMORY=1G

# Number of queue worker processes.
QUEUE_WORKERS=1

# Run `php artisan migrate --force` when the container starts.
RUN_MIGRATIONS=false

# Run `php artisan db:seed --force` when the container starts.
RUN_SEEDER=false
