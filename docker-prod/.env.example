# Compose settings for docker-prod (copy to docker-prod/.env).

# --- gluetun ----------------------------------------------------------------
# See https://github.com/qdm12/gluetun-wiki for your provider's variables.
VPN_SERVICE_PROVIDER=
VPN_TYPE=wireguard
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESSES=
# OPENVPN_USER=
# OPENVPN_PASSWORD=
SERVER_COUNTRIES=
TZ=UTC

# --- seedboxapi -------------------------------------------------------------
# Image to run. .github/workflows/docker-publish.yml publishes
# ghcr.io/gjhuerte/seedboxapi; leave the default to build locally.
SEEDBOXAPI_IMAGE=seedboxapi
SEEDBOXAPI_TAG=latest

# Owner of the files in seedboxapi-volume/ (`id -u` / `id -g`).
PUID=1000
PGID=1000

# Optional: initial mam_id. You can also paste it in the web UI. A changed
# value here replaces the stored one on the next start.
MAM_ID=

# Seconds between updates (minimum 60, rounded up to whole minutes).
INTERVAL=600

# 1 = log every check (also shown in the UI's Logs tab).
DEBUG=0

# Port the web UI listens on inside gluetun's network, and where gluetun
# publishes it on the host. Keep 127.0.0.1 unless you need LAN access.
PORT=8095
SEEDBOXAPI_BIND=127.0.0.1
SEEDBOXAPI_HTTP_PORT=8095

# Optional HTTP Basic auth for the web UI (set both). Recommended when
# SEEDBOXAPI_BIND=0.0.0.0.
UI_USERNAME=
UI_PASSWORD=
