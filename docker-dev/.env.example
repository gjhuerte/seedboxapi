# Compose settings for docker-dev (copy to docker-dev/.env).
# Application settings (APP_KEY, DB_* …) live in the project .env.

# Path to the project on the host (defaults to the repository root).
PROJECT_PATH=..

# Your host user, so files written by the container stay yours: `id -u` / `id -g`.
UID=1000
GID=1000

# Ports are published on localhost only. Use 0.0.0.0 to reach them from your LAN.
APP_BIND=127.0.0.1
APP_PORT=8009
VITE_PORT=5173

# This container is not behind the VPN: keep automatic MAM updates off unless
# you really want MAM to see this machine's IP.
MAM_AUTO_SYNC=false
INTERVAL=600
DEBUG=0

# Xdebug: off | debug | develop | coverage | profile | trace (combine with commas).
XDEBUG_MODE=off

# Vite dev server inside the container (hot reload on http://localhost:5173).
VITE_DEV_SERVER=true
VITE_HMR_HOST=localhost
# Set to true if file changes are not picked up (e.g. Docker Desktop on macOS/Windows).
VITE_POLLING=false
